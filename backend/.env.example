DEVLOOP_ENV=dev
DEVLOOP_DATABASE_URL=postgresql+psycopg://devloop:devloop@localhost:5433/devloop
DEVLOOP_NEO4J_URI=bolt://localhost:7687
DEVLOOP_NEO4J_USER=neo4j
DEVLOOP_NEO4J_PASSWORD=devloopdevloop
# 憑證加密金鑰。每個部署一把，換掉的話所有已存的 token 都要重新輸入。
# 產生：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVLOOP_SECRET_KEY=
# Jira 設定不在這裡 —— 走 /settings 頁面填，加密後存進資料庫
# 被 DevLoop 管理的專案根目錄 —— claude 子行程的 cwd 限制在這裡面
DEVLOOP_WORKSPACE_ROOT=/Users/sam/Desktop/JobHunting/JobRadar
DEVLOOP_CLAUDE_BIN=claude
DEVLOOP_LOG_LEVEL=INFO
